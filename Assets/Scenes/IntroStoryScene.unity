  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::IntroNarrationManager
  narrationText: {fileID: 276649244}
  narrationCanvasGroup: {fileID: 276649241}
  narrationLines:
  - Text: Ako si Miguel, isang batang mananaliksik ng kasaysayan.
    HoldDuration: 5
    PauseAfter: 1
  - Text: "Sa pag-aaral ko sa mga akda ni Jos\xE9 Rizal, may isang hindi natapos
      na nobela na talagang nakakuha ng pansin ko"
    HoldDuration: 8
    PauseAfter: 1
  - Text: Ang Makamisa.
    HoldDuration: 4
    PauseAfter: 1
  - Text: ' Hindi ko maiwasang isipin kung ano ang maaaring mabuo mula sa mga naiwan
      nitong bahagi.'
    HoldDuration: 7
    PauseAfter: 1
  fadeDuration: 1
